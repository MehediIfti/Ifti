{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/whiteboard", "destination": "/whiteboard/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/whiteboard/", "destination": "https://mehediifti.github.io/whiteboard/" },
    { "source": "/whiteboard/:path*", "destination": "https://mehediifti.github.io/whiteboard/:path*" }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
