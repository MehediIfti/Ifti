{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/whiteboard", "destination": "/whiteboard/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/whiteboard/", "destination": "https://whiteboard-mu-two.vercel.app/" },
    { "source": "/whiteboard/:path*", "destination": "https://whiteboard-mu-two.vercel.app/:path*" }
  ],
  "headers": [
    { "source": "/fonts/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/api/((?!now-playing|status|f1|weather|activity).*)", "headers": [{ "key": "Cache-Control", "value": "no-store" }] }
  ]
}
